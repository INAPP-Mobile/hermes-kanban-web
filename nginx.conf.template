# Hermes Kanban Web router — one public URL, two upstreams:
#   /          -> uvicorn (FastAPI kanban app, 127.0.0.1:12700)
#   /terminal/ -> ttyd web terminal (127.0.0.1:7681, HTTP Basic Auth)
#
# Generated at boot by /etc/cont-init.d/90-kanban-nginx from
# /etc/nginx/nginx.conf.template (__PORT__ is substituted with $PORT).
# Runs as the hermes user (supervisord), so pid/log/temp paths live in /tmp.

include /etc/nginx/modules-enabled/*.conf;

worker_processes auto;
pid /tmp/nginx.pid;
error_log /tmp/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/xml;

    # Writable temp dirs for the non-root hermes user
    client_body_temp_path /tmp/nginx-client-temp;
    proxy_temp_path /tmp/nginx-proxy-temp;
    fastcgi_temp_path /tmp/nginx-fastcgi-temp;
    uwsgi_temp_path /tmp/nginx-uwsgi-temp;
    scgi_temp_path /tmp/nginx-scgi-temp;

    server {
        listen __PORT__ default_server;
        server_name _;
        access_log /tmp/nginx-access.log;

        # FastAPI app — SSE-friendly (no buffering, long read timeout)
        location / {
            proxy_pass http://127.0.0.1:12700;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
        }

        # ttyd web terminal — page + token endpoint behind HTTP Basic Auth.
        # Note: the WebSocket upgrade path (/terminal/ws) is a separate location
        # below WITHOUT auth_basic, because browsers do not send cached HTTP
        # Basic credentials on WebSocket handshakes (auth_basic would 401 every
        # upgrade). Security there is enforced by ttyd's own auth: the -H
        # auth-header check (nginx injects X-Auth-User) plus the AuthToken
        # first-message check, where the token only comes from the
        # auth-protected /terminal/token endpoint.
        location /terminal {
            auth_basic "Hermes Kanban terminal";
            auth_basic_user_file /etc/nginx/.htpasswd;
            proxy_set_header X-Auth-User $remote_user;
            proxy_pass http://127.0.0.1:7681/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }

        # ttyd WebSocket endpoint — NO auth_basic (browsers don't send cached
        # basic auth on WS handshakes). ttyd runs with -H X-Auth-User (header
        # presence check) + -c credential (AuthToken first-message check), so
        # the terminal is still gated on a token obtainable only from the
        # auth-protected /terminal/token endpoint.
        location = /terminal/ws {
            proxy_set_header X-Auth-User kanban;
            proxy_pass http://127.0.0.1:7681/ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }
    }
}
