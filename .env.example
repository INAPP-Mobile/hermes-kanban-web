# Railway injects PORT automatically. This app defaults to 8502 locally.
PORT=8502

# Web terminal (/terminal/) basic-auth credentials (ttyd behind nginx).
# If ADMIN_PASSWORD is left empty, a random password is generated at boot
# and printed to the container logs (user defaults to "admin").
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# HERMES_HOME is the root directory for all Hermes persistent state.
# Inside the container this defaults to /opt/data (mounted as a Railway volume).
# The kanban app reads config from here and shells out to the hermes CLI.
# On your host, set this to your local ~/.hermes directory or leave unset
# to use the default.
# HERMES_HOME=/home/user/.hermes

# Optional: override the orchestrator profile used for new boards.
# HERMES_KANBAN_ORCHESTRATOR=default

# LLM provider configuration (written by the setup wizard to .env in HERMES_HOME).
# Set these manually if you prefer not to use the wizard modal on first visit.
# These are consumed by the Hermes agent runtime (hermes CLI), not uvicorn directly.
# HERMES_MODEL=qwen3:8b                    # top-level model in config.yaml

# Provider env vars (any non-empty value marks the provider as configured):
# On Railway, the bundled Ollama companion service is auto-linked here:
# OLLAMA_BASE_URL=http://ollamaollamalatest.railway.internal:11434
# Locally, point it at your own Ollama: OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=gsk_...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
