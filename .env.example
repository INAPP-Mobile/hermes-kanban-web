# Railway injects PORT automatically. This app defaults to 8502 locally.
PORT=8502

# HERMES_HOME is the root directory for all Hermes persistent state.
# Inside the container this defaults to /opt/data (mounted as a Railway volume).
# The kanban app reads config from here and shells out to the hermes CLI.
# On your host, set this to your local ~/.hermes directory or leave unset
# to use the default.
# HERMES_HOME=/home/user/.hermes

# Optional: override the orchestrator profile used for new boards.
# HERMES_KANBAN_ORCHESTRATOR=worker3
